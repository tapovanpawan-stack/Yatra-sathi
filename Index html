<script>
const q=id=>document.getElementById(id);
function show(id){document.querySelectorAll('section').forEach(x=>x.classList.remove('active'));q(id).classList.add('active');scrollTo(0,0);if(id==='bus')renderBus();if(id==='hotel')renderHotel();if(id==='package')renderPackage();if(id==='poster')renderPosters();if(id==='live')renderLive();if(id==='free')renderShops();if(id==='shop')renderShops();if(id==='horoscope')showHoroscope()}
function arr(k){return JSON.parse(localStorage.getItem(k)||'[]')}function set(k,v){localStorage.setItem(k,JSON.stringify(v))}
function saveBus(){let x={n:q('bn').value,o:q('bo').value,p:q('bp').value,t:q('bt').value,s:q('bs').value,r:q('br').value,w:q('bw').value};if(!x.n||!x.p){q('bm').innerHTML='⚠️ नाम और मोबाइल भरें';return}let a=arr('buses');a.push(x);set('buses',a);q('bm').innerHTML='✅ Listing सेव हो गई';['bn','bo','bp','bs','br','bw'].forEach(id=>q(id).value='');renderBus()}
function renderBus(){let a=arr('buses');q('bl').innerHTML=a.length?a.map((x,i)=>`<div class=item><b>🚌 ${x.n}</b><br>मालिक: ${x.o||'-'}<br>${x.t} | ${x.s||'-'} सीट<br>रूट: ${x.r||'-'}<br>📞 ${x.p}<br><button class="btn green" onclick="location.href='tel:${x.p}'">Call</button><button class="btn green" onclick="location.href='https://wa.me/91${x.w||x.p}'">WhatsApp</button><button class="btn red" onclick="del('buses',${i},'bus')">Delete</button></div>`).join(''):'अभी कोई Bus Listing नहीं है।'}
function saveHotel(){let x={n:q('hn').value,p:q('hp').value,ph:q('hph').value,r:q('hr').value};if(!x.n||!x.ph){q('hm').innerHTML='⚠️ होटल नाम और मोबाइल भरें';return}let a=arr('hotels');a.push(x);set('hotels',a);q('hm').innerHTML='✅ Hotel सेव हो गया';['hn','hp','hph','hr'].forEach(id=>q(id).value='');renderHotel()}
function renderHotel(){let a=arr('hotels');q('hl').innerHTML=a.length?a.map((x,i)=>`<div class=item><b>🏨 ${x.n}</b><br>स्थान: ${x.p||'-'}<br>किराया: ${x.r||'-'}<br>📞 ${x.ph}<br><button class="btn green" onclick="location.href='tel:${x.ph}'">Call</button><button class="btn red" onclick="del('hotels',${i},'hotel')">Delete</button></div>`).join(''):'अभी कोई Hotel Listing नहीं है।'}
function savePackage(){let x={n:q('pn').value,r:q('pr').value,c:q('pc').value,d:q('pd').value,ph:q('pph').value,wa:q('pwa').value};if(!x.n){q('pm').innerHTML='⚠️ यात्रा का नाम भरें';return}let a=arr('packages');a.push(x);set('packages',a);q('pm').innerHTML='✅ Package सेव हो गया';['pn','pr','pc','pd','pph','pwa'].forEach(id=>q(id).value='');renderPackage()}
function renderPackage(){let a=arr('packages');q('pl').innerHTML=a.length?a.map((x,i)=>{let ph=x.ph||'9991624086',wa=x.wa||'9306363805';return `<div class=item><b>🛕 ${x.n}</b><br>रूट: ${x.r||'-'}<br>किराया: ${x.c||'-'}<br>${x.d||''}<br><button class="btn green" onclick="location.href='tel:${ph}'">📞 Call Now</button><button class="btn green" onclick="location.href='https://wa.me/91${wa}?text=Namaste%20Tapovan%20Traveller%20ji%2C%20mujhe%20${encodeURIComponent(x.n)}%20ke%20baare%20mein%20jaankari%20chahiye.'">💬 WhatsApp</button><button class="btn red" onclick="del('packages',${i},'package')">Delete</button></div>`}).join(''):'अभी कोई Package नहीं है।'}
function del(k,i,type){let a=arr(k);a.splice(i,1);set(k,a);type==='bus'?renderBus():type==='hotel'?renderHotel():type==='package'?renderPackage():renderShops()}
function savePoster(){
let f=q('posterfile').files[0], n=q('postern').value||'Yatra Poster', ph=q('posterph').value||'9991624086', wa=q('posterwa').value||'9306363805';
if(!f){q('postermsg').innerHTML='⚠️ पहले पोस्टर की फोटो चुनें';return}
let r=new FileReader();r.onload=()=>{let a=arr('posters');a.push({name:n,data:r.result,ph,wa});set('posters',a);q('postermsg').innerHTML='✅ Poster सेव हो गया';q('postern').value='';q('posterfile').value='';renderPosters()};r.readAsDataURL(f)
}
function renderPosters(){
let a=arr('posters');
q('posters').innerHTML=a.length?a.map((x,i)=>`<div class=item><b>🖼️ ${x.name}</b><br><img class=preview src="${x.data}"><br><button class="btn green" onclick="location.href='tel:${x.ph||'9991624086'}'">📞 Call Now</button><button class="btn green" onclick="location.href='https://wa.me/91${x.wa||'9306363805'}?text=Namaste%20Tapovan%20Traveller%20ji%2C%20mujhe%20${encodeURIComponent(x.name)}%20ke%20baare%20mein%20jaankari%20chahiye.'">💬 WhatsApp</button><button class="btn red" onclick="delPoster(${i})">Delete</button></div>`).join(''):'अभी कोई Poster नहीं है।'}
function delPoster(i){let a=arr('posters');a.splice(i,1);set('posters',a);renderPosters()}
function saveLive(){let n=q('ln').value,u=q('lu').value;if(!n||!u){q('ll').innerHTML='⚠️ मंदिर का नाम और URL भरें';return}let a=arr('live');a.push({n,u});set('live',a);q('ln').value='';q('lu').value='';renderLive()}
